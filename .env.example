# MINDCRAFT — Environment Configuration Template
# Duplicate this file to .env.local for local development.

# Neon PostgreSQL Database URL (Server-Only, Never Expose in Client Bundle)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT Secret for Session Authentication & RBAC
JWT_SECRET="mindcraft_super_secret_jwt_key_change_in_production_min_32_chars"

# Optional LLM Provider Keys (Server-Side Only)
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Environment
NODE_ENV="development"
