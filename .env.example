# MINDCRAFT — Environment Configuration Template
# Duplicate this file to .env.local for local development.

# Neon PostgreSQL Database URL (Pooled connection for queries)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Neon PostgreSQL Direct URL (Direct connection for Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT Secret for Session Authentication & RBAC (Minimum 32 characters)
JWT_SECRET="mindcraft_super_secret_jwt_key_change_in_production_min_32_chars"

# AI Provider API Keys (Supports single or multiple comma-separated keys for auto-failover)
GROQ_API_KEYS=""
GEMINI_API_KEYS=""
OPENROUTER_API_KEYS=""
DEEPGRAM_API_KEYS=""

# Environment
NODE_ENV="development"
