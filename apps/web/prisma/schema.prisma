// MINDCRAFT Database Schema (Neon PostgreSQL / Prisma ORM)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  MODERATOR
  ML_OPERATOR
}

enum ModelStatus {
  CANDIDATE
  EVALUATION
  RELEASE_CANDIDATE
  APPROVED
  PRODUCTION
  REJECTED
  ARCHIVED
}

enum EpisodeOutcome {
  GOAL_REACHED
  TIMEOUT
  OBSTACLE_COLLISION
  LAVA_HAZARD
  MOB_DEFEAT
  ABORTED
}

enum ChallengeType {
  PARKOUR_CHASM
  LAVA_BRIDGING
  NIGHT_SURVIVAL
  SPEEDRUN_ECONOMY
  PILLAR_MOUNTAIN
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  role            Role             @default(USER)
  createdAt       DateTime         @default(now())
  lastActiveAt    DateTime         @updatedAt
  profile         Profile?
  sessions        Session[]
  auditLogs       AuditLog[]
  challengeScores ChallengeScore[]

  @@map("users")
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String
  avatarUrl   String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Model {
  id          String         @id @default(uuid())
  name        String
  description String
  taskFamily  String         @default("Minecraft-Embodied-Survival")
  versions    ModelVersion[]
  createdAt   DateTime       @default(now())

  @@map("models")
}

model ModelVersion {
  id              String           @id @default(uuid())
  modelId         String
  versionTag      String
  artifactUri     String
  modelHashSha256 String
  status          ModelStatus      @default(CANDIDATE)
  fileSizeKb      Float
  publishedAt     DateTime?
  retiredAt       DateTime?
  createdAt       DateTime         @default(now())
  model           Model            @relation(fields: [modelId], references: [id], onDelete: Cascade)
  trainingRuns    TrainingRun[]
  evaluations     Evaluation[]
  sessions        Session[]
  telemetryEvents TelemetryEvent[]
  challengeScores ChallengeScore[]

  @@unique([modelId, versionTag])
  @@map("model_versions")
}

model TrainingRun {
  id                  String       @id @default(uuid())
  modelVersionId      String
  algorithm           String       @default("PPO")
  environmentVersion  String       @default("v6-minecraft")
  rewardVersion       String       @default("v6-potential-crafting")
  hyperparametersJson Json
  timestepsTrained    Int
  peakReward          Float
  startedAt           DateTime     @default(now())
  finishedAt          DateTime?
  gitCommit           String?      @default("main-minecraft-release")
  modelVersion        ModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)

  @@map("training_runs")
}

model Evaluation {
  id                    String       @id @default(uuid())
  modelVersionId        String
  scenario              String
  heldOutSeedsCount     Int
  successRatePercent    Float
  generalizationScore   Float
  meanEpisodeReward     Float
  meanEpisodeSteps      Float
  avgInferenceLatencyMs Float
  passedReleaseGate     Boolean
  createdAt             DateTime     @default(now())
  modelVersion          ModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)

  @@map("evaluations")
}

model Challenge {
  id             String           @id @default(uuid())
  slug           String           @unique
  title          String
  description    String
  challengeType  ChallengeType
  difficulty     String           @default("Medium") // Easy, Medium, Hard, Expert
  parTimeSeconds Int              @default(60)
  targetScore    Int              @default(1000)
  scores         ChallengeScore[]
  createdAt      DateTime         @default(now())

  @@map("challenges")
}

model ChallengeScore {
  id             String        @id @default(uuid())
  challengeId    String
  userId         String?
  modelVersionId String?
  agentName      String        @default("Master AI Agent")
  score          Int
  timeElapsedSec Float
  heartsLeft     Float         @default(10.0)
  blocksPlaced   Int           @default(0)
  resourcesMined Int           @default(0)
  passed         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  challenge      Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  modelVersion   ModelVersion? @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)

  @@index([challengeId])
  @@index([score])
  @@map("challenge_scores")
}

model Session {
  id              String           @id @default(uuid())
  userId          String?
  modelVersionId  String?
  ipHash          String?
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  goalsAttempted  Int              @default(0)
  goalsCompleted  Int              @default(0)
  avgFps          Float?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  modelVersion    ModelVersion?    @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)
  telemetryEvents TelemetryEvent[]

  @@map("sessions")
}

model TelemetryEvent {
  id                String          @id @default(uuid())
  sessionId         String
  modelVersionId    String?
  eventType         String          // e.g. SESSION_STARTED, BLOCK_MINED, BLOCK_PLACED, CREEPER_EVADED, GOAL_COMPLETED
  outcome           EpisodeOutcome?
  rewardAccumulated Float?
  stepsTaken        Int?
  payloadJson       Json?
  createdAt         DateTime        @default(now())
  session           Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  modelVersion      ModelVersion?   @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([eventType])
  @@map("telemetry_events")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String   // e.g. MODEL_PUBLISHED, MODEL_ROLLED_BACK, USER_LOGIN, CHALLENGE_COMPLETED
  targetType String   // e.g. ModelVersion, Challenge, User
  targetId   String?
  details    Json?
  timestamp  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}
