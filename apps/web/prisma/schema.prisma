// MINDCRAFT — Complete Multi-Agent AI & System Database Schema (Neon PostgreSQL / Prisma ORM)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  MODERATOR
  ML_OPERATOR
}

enum ModelStatus {
  TRAINING
  CANDIDATE
  EVALUATING
  APPROVED
  ACTIVE
  RETIRED
  REJECTED
}

enum CharacterRole {
  EXPLORER
  GUARDIAN
  BUILDER
  SURVIVOR
}

enum EventQuality {
  PENDING
  REJECTED_CORRUPT
  REJECTED_SPAM
  APPROVED_TRAINING
}

// ----------------------------------------------------
// IDENTITY & GAME PROFILES
// ----------------------------------------------------
model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  role            Role             @default(USER)
  createdAt       DateTime         @default(now())
  lastActiveAt    DateTime         @updatedAt
  profile         Profile?
  gameProfiles    GameProfile[]
  sessions        Session[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String
  avatarUrl   String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model GameProfile {
  id               String              @id @default(uuid())
  gameId           String              @unique // Unique persistent Game ID e.g. "GAME-7842-MC"
  userId           String
  worldSeed        Int                 @default(42)
  level            Int                 @default(1)
  experiencePts    Int                 @default(0)
  totalPlayTimeSec Int                 @default(0)
  playerX          Float               @default(2.5)
  playerY          Float               @default(0.0)
  playerZ          Float               @default(2.5)
  inventoryJson    Json                @default("{\"wood\":0,\"stone\":0,\"iron\":0,\"diamond\":0,\"cobble\":16}")
  version          Int                 @default(1)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterStates  CharacterProgress[]
  sessions         Session[]

  @@index([userId])
  @@index([gameId])
  @@map("game_profiles")
}

// ----------------------------------------------------
// AI CHARACTERS & SKILL LIBRARY
// ----------------------------------------------------
model Character {
  id                String              @id @default(uuid())
  slug              String              @unique // "explorer", "guardian", "builder", "survivor"
  name              String
  role              CharacterRole
  description       String
  curiosity         Float               @default(0.8)
  riskTolerance     Float               @default(0.5)
  priorityTask      String
  rewardWeightsJson Json
  activeModelId     String?
  createdAt         DateTime            @default(now())
  skills            CharacterSkill[]
  modelVersions     ModelVersion[]
  characterProgress CharacterProgress[]

  @@map("characters")
}

model Skill {
  id            String           @id @default(uuid())
  slug          String           @unique // "cross_river", "intercept_threat", "build_bridge"
  name          String
  description   String
  preconditions String
  successRate   Float            @default(0.0)
  usageCount    Int              @default(0)
  createdAt     DateTime         @default(now())
  characters    CharacterSkill[]

  @@map("skills")
}

model CharacterSkill {
  id          String    @id @default(uuid())
  characterId String
  skillId     String
  proficiency Float     @default(1.0)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([characterId, skillId])
  @@index([skillId])
  @@map("character_skills")
}

model CharacterProgress {
  id            String      @id @default(uuid())
  gameProfileId String
  characterId   String
  posX          Float       @default(4.0)
  posY          Float       @default(0.0)
  posZ          Float       @default(4.0)
  health        Float       @default(1.0)
  stamina       Float       @default(1.0)
  missionsDone  Int         @default(0)
  statusState   String      @default("IDLE")
  lastAction    String      @default("WAIT")
  updatedAt     DateTime    @updatedAt
  gameProfile   GameProfile @relation(fields: [gameProfileId], references: [id], onDelete: Cascade)
  character     Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([gameProfileId, characterId])
  @@index([characterId])
  @@map("character_progress")
}

// ----------------------------------------------------
// MODEL REGISTRY & TRAINING PIPELINE
// ----------------------------------------------------
model ModelVersion {
  id              String           @id @default(uuid())
  characterId     String
  versionTag      String           // e.g. "explorer_v2", "guardian_v1", "builder_v1"
  artifactUri     String           // e.g. "/models/explorer_v2.onnx"
  modelHashSha256 String
  status          ModelStatus      @default(CANDIDATE)
  fileSizeKb      Float
  canaryPercent   Int              @default(100) // 0-100% rollout
  publishedAt     DateTime?
  retiredAt       DateTime?
  createdAt       DateTime         @default(now())
  character       Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  trainingRuns    TrainingRun[]
  evaluations     Evaluation[]
  telemetryEvents TelemetryEvent[]

  @@unique([characterId, versionTag])
  @@index([status])
  @@index([versionTag])
  @@map("model_versions")
}

model TrainingRun {
  id                  String       @id @default(uuid())
  modelVersionId      String
  algorithm           String       @default("PPO")
  environmentVersion  String       @default("v6-32x32-voxel")
  rewardVersion       String       @default("v6-character-dna")
  hyperparametersJson Json
  timestepsTrained    Int
  peakReward          Float
  datasetId           String?
  startedAt           DateTime     @default(now())
  finishedAt          DateTime?
  gitCommit           String?      @default("main-release-2026")
  modelVersion        ModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  dataset             Dataset?     @relation(fields: [datasetId], references: [id], onDelete: SetNull)

  @@index([modelVersionId])
  @@index([datasetId])
  @@map("training_runs")
}

model Evaluation {
  id                    String       @id @default(uuid())
  modelVersionId        String
  scenario              String       // e.g. "Unseen River Scenarios (50 Maps)", "Adversarial Threat Interception"
  heldOutSeedsCount     Int
  successRatePercent    Float
  generalizationScore   Float
  meanEpisodeReward     Float
  meanEpisodeSteps      Float
  avgInferenceLatencyMs Float
  passedReleaseGate     Boolean
  isChampionVsCandidate Boolean      @default(false)
  createdAt             DateTime     @default(now())
  modelVersion          ModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)

  @@index([modelVersionId])
  @@map("evaluations")
}

model Dataset {
  id             String        @id @default(uuid())
  versionTag     String        @unique // e.g. "dataset_v1_approved"
  description    String
  approvedEvents Int           @default(0)
  totalEpisodes  Int           @default(0)
  createdAt      DateTime      @default(now())
  trainingRuns   TrainingRun[]

  @@map("datasets")
}

// ----------------------------------------------------
// SESSIONS & APPROVED EXPERIENCE TELEMETRY
// ----------------------------------------------------
model Session {
  id              String           @id @default(uuid())
  userId          String?
  gameProfileId   String?
  ipHash          String?
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  goalsAttempted  Int              @default(0)
  goalsCompleted  Int              @default(0)
  avgFps          Float?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  gameProfile     GameProfile?     @relation(fields: [gameProfileId], references: [id], onDelete: SetNull)
  telemetryEvents TelemetryEvent[]

  @@index([userId])
  @@index([gameProfileId])
  @@index([startedAt])
  @@map("sessions")
}

model TelemetryEvent {
  id                String        @id @default(uuid())
  sessionId         String
  modelVersionId    String?
  eventType         String        // e.g. "RIVER_CROSSED", "THREAT_INTERCEPTED", "BRIDGE_BUILT", "GOAL_REACHED"
  qualityStatus     EventQuality  @default(APPROVED_TRAINING)
  outcome           String?
  rewardAccumulated Float?
  stepsTaken        Int?
  payloadJson       Json?
  createdAt         DateTime      @default(now())
  session           Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  modelVersion      ModelVersion? @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([eventType])
  @@index([qualityStatus])
  @@map("telemetry_events")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String   // e.g. "MODEL_PROMOTED", "MODEL_ROLLED_BACK", "CANARY_UPDATED", "USER_REGISTERED"
  targetType String
  targetId   String?
  details    Json?
  timestamp  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([timestamp])
  @@index([targetType])
  @@map("audit_logs")
}
