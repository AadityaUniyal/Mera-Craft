{
  "name": "mindcraft-master",
  "version": "1.0.0",
  "private": true,
  "description": "MINDCRAFT — Autonomous Embodied AI Voxel Lab with PyTorch PPO and ONNX WebAssembly",
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "test:ai": "python -m pytest training/tests/test_env_and_model.py -v",
    "train": "python training/scripts/train.py",
    "train:resume": "python training/scripts/train.py --resume training/checkpoints/mindcraft_master.pt",
    "evaluate": "python training/evaluation/evaluate.py --checkpoint training/checkpoints/mindcraft_master.pt",
    "export": "python training/scripts/export.py"
  },
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "next": "^14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "prisma": "^5.22.0"
  }
}
